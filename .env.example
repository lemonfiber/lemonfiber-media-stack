# Copy to .env and edit. Every variable the stack reads is listed here; anything
# with a sensible default is already set to it, so the shortest working file is
# DATA_ROOT plus, if you want torrents, a WireGuard key.

# ── Core ──────────────────────────────────────────────────────────────────
# The single data root. Downloads AND media live under here as subdirectories,
# on ONE filesystem, so imports hardlink instead of copy. Splitting them across
# two mounts silently turns every import into a copy — slower, and twice the
# disk while it runs.
DATA_ROOT=./data

# The user that owns everything under DATA_ROOT. `id -u` and `id -g`.
PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# ── Binding ───────────────────────────────────────────────────────────────
# Admin services — the *arrs, SABnzbd, qBittorrent, Prowlarr, NZBHydra2,
# Bindery — are always on 127.0.0.1 and are not configurable here. They hold
# full control of the stack and most ship with weak or disabled default
# authentication.
#
# Household services — Jellyfin, Seerr, Calibre-Web, Audiobookshelf, Homepage —
# are published on LAN_BIND, because a library the TV cannot reach is not a
# library.
#
# 0.0.0.0 means every interface on this machine. Narrow it to the one address
# the household actually uses, e.g. LAN_BIND=192.168.1.10. Two things worth
# knowing: Docker's port publishing bypasses some host firewalls, so a rule you
# added may not apply here; and the LAN tier assumes the network is trusted,
# which a café or a shared flat is not.
LAN_BIND=0.0.0.0

# ── VPN (torrents) ────────────────────────────────────────────────────────
# Gluetun supports ~24 providers. Only ProtonVPN, PIA, PrivateVPN and Perfect
# Privacy support port forwarding; leave VPN_PORT_FORWARDING off for others,
# where the port machinery simply does not run.
VPN_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=
VPN_COUNTRIES=Netherlands
# ProtonVPN: enable port forwarding when GENERATING the WireGuard config, and
# pick a P2P server — it cannot be turned on at runtime.
VPN_PORT_FORWARDING=on

# ── Service tuning ────────────────────────────────────────────────────────
# Umask for files Unpackerr extracts. 002 leaves them group-writable so the
# *arrs can import them.
UMASK=002
FLARESOLVERR_LOG_LEVEL=info
SEERR_LOG_LEVEL=info
# When Recyclarr syncs quality profiles. Cron expression or @daily / @weekly.
RECYCLARR_CRON=@daily

# Jellyfin hardware transcoding. Uncomment the `devices` and `group_add` lines
# in compose/media.yml, then set this to the host's render group id:
#   getent group render | cut -d: -f3
# RENDER_GID=

# ── Homepage (dash profile) ───────────────────────────────────────────────
# Homepage refuses requests whose Host header it does not recognise. List every
# address the household types, comma-separated.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000
# What the dashboard's household links point at — the address a phone can
# reach, not the address of the container.
HOMEPAGE_VAR_LAN_HOST=localhost

# ── Seeded credentials ────────────────────────────────────────────────────
# Empty by design. `lemonfiber seed` reads each service's own config file and
# fills these in; until then, widgets render without data, Recyclarr logs an
# authentication failure each cycle, and Unpackerr idles. Nothing here is
# required for the stack to start.
#
# Setting them by hand is supported — each app shows its key under
# Settings → General.
SONARR_API_KEY=
RADARR_API_KEY=

HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_SEERR_KEY=
HOMEPAGE_VAR_AUDIOBOOKSHELF_KEY=
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_LIDARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_SABNZBD_KEY=
HOMEPAGE_VAR_QBITTORRENT_USER=
HOMEPAGE_VAR_QBITTORRENT_PASS=

UN_SONARR_0_URL=
UN_SONARR_0_API_KEY=
UN_RADARR_0_URL=
UN_RADARR_0_API_KEY=
UN_LIDARR_0_URL=
UN_LIDARR_0_API_KEY=

# ── Proxy overlay (proxy profile, off by default) ─────────────────────────
# A domain whose DNS points at this machine. Caddy then obtains real
# certificates automatically — see config/caddy/Caddyfile for which hostnames
# it serves, and which are deliberately left disabled.
DOMAIN=home.example
CADDY_EMAIL=

# ── NAS overlay (stacks/compose.storage.nas.yml, off by default) ──────────
# Only read when that overlay is applied — for a data root on a network mount
# where hardlinks are unavailable. Both are required if it is.
NAS_HOST=
NAS_EXPORT=
