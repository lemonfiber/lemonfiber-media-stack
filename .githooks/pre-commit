#!/bin/sh
# The fast checks CI runs, before the commit rather than after the push.
#
# Fast only: the slow gates stay in the repository’s own `ci` recipe, because a
# hook that takes a minute is a hook people turn off, and one that is off
# enforces nothing (OPS-R51, Q-R57).
#
# Each check is skipped where its tool is absent, so a contributor without it
# gets CI’s answer rather than a hook that cannot run.

set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM)
command -v python3 >/dev/null 2>&1 || exit 0

case "$staged" in
*stack.toml* | *compose* | *stacks/*)
	python3 scripts/validate_manifest.py && python3 scripts/check_forms.py || exit 1
	;;
esac

case "$staged" in
*scripts/*.py*)
	python3 scripts/test_validate_manifest.py || exit 1
	;;
esac

exit 0
