#!/bin/sh
# The fast checks CI runs, before the commit rather than after the push.
#
# Fast only: the slow gates stay in the repository’s own `ci` recipe, because a
# hook that takes a minute is a hook people turn off, and one that is off
# enforces nothing (OPS-R51, Q-R57).
#
# Each check is skipped where its tool is absent, so a contributor without it
# gets CI’s answer rather than a hook that cannot run.

set -eu

# Say what did not run, and why. A check skipped because its tool is absent and a
# check that found nothing are the same silence otherwise, and the second is what
# somebody reads the first as — so the hook reports a pass it did not earn.
say() {
	printf 'pre-commit: %s\n' "$1" >&2
}

staged=$(git diff --cached --name-only --diff-filter=ACM)

if ! command -v python3 >/dev/null 2>&1; then
	say "python3 is not installed, so the manifest, the forms and the script suite were not checked here. All three run in CI."
	exit 0
fi

ran=""

case "$staged" in
*stack.toml* | *compose* | *stacks/*)
	python3 scripts/validate_manifest.py && python3 scripts/check_forms.py || exit 1
	ran="${ran}manifest and forms; "
	;;
esac

case "$staged" in
*scripts/*.py*)
	python3 scripts/test_validate_manifest.py || exit 1
	ran="${ran}the manifest suite; "
	;;
esac

# Nothing staged that any of the checks above reads. Said rather than left as a
# silent pass: this hook is scoped by path and "it did not apply" is a different
# answer from "it was happy".
if [ -z "$ran" ]; then
	ran="nothing staged that these checks read; "
fi
say "ran: ${ran%; }"
exit 0
