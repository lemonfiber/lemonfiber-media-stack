# The library. Never ours to track.
/data/

# Each service's /config is runtime state it writes itself — databases, API
# keys, session tokens. Ignored wholesale, then the templates we ship are
# re-admitted one by one below. A directory has to be re-included before
# anything inside it can be.
/config/*/

# Seeded templates. Each directory is re-included before the file inside it,
# because git cannot re-include a file whose parent directory is excluded.
!/config/recyclarr/
!/config/recyclarr/*.yml
!/config/homepage/
!/config/homepage/*.yaml
!/config/caddy/
!/config/caddy/Caddyfile

# ...but those three directories are also live config directories, so the state
# each service writes into them goes back on the ignore list.
/config/recyclarr/cache/
/config/recyclarr/logs/
/config/recyclarr/repositories/
/config/homepage/logs/

.env
.planning/
.DS_Store
