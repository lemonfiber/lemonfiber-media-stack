# The library. Never ours to track.
/data/

# Each service's /config is runtime state it writes itself — databases, API
# keys, session tokens.
/config/*/

# Three of those directories also hold templates we ship. Each is re-included,
# then its contents are excluded again, then the template files are named one by
# one. All three steps are needed: git cannot re-include a file whose parent
# directory is excluded, and re-including the directory alone would admit
# everything the service later writes into it.
!/config/recyclarr/
/config/recyclarr/*
!/config/recyclarr/recyclarr.yml

!/config/homepage/
/config/homepage/*
!/config/homepage/settings.yaml
!/config/homepage/services.yaml
!/config/homepage/widgets.yaml

!/config/caddy/
/config/caddy/*
!/config/caddy/Caddyfile

.env
.planning/
.DS_Store
