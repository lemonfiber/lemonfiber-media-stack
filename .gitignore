# The library. Never ours to track.
/data/

# Each service's /config is runtime state it writes itself — databases, API
# keys, session tokens.
/config/*/

# Some of those directories are shipped anyway, for one of two reasons, and both
# need the same three steps: re-include the directory, exclude its contents
# again, then name what we keep. Git cannot re-include a file whose parent is
# excluded, and re-including the directory alone would admit everything the
# service later writes into it.
#
# The first reason is a template we ship. The second is subtler and cost three
# services their first start: Docker creates a missing bind-mount source as
# root:root, and a container that runs as a fixed non-root user cannot then
# write its own /config. The LSIO images start as root and chown it, so they
# never meet this. Jellyfin, Seerr and Bindery do not, so their directories have
# to exist before Docker would make one — and a directory that exists in the
# clone belongs to whoever cloned it, which is what PUID/PGID are set to.
!/config/recyclarr/
/config/recyclarr/*
!/config/recyclarr/recyclarr.yml
!/config/recyclarr/includes/
/config/recyclarr/includes/*
!/config/recyclarr/includes/*.yml

!/config/homepage/
/config/homepage/*
!/config/homepage/settings.yaml
!/config/homepage/services.yaml
!/config/homepage/widgets.yaml

!/config/caddy/
/config/caddy/*
!/config/caddy/Caddyfile

!/config/sabnzbd/
/config/sabnzbd/*
!/config/sabnzbd/sabnzbd.ini

# Shipped empty, so that Docker never creates them as root. Nothing in them is
# ours to track; the directory itself is the whole point.
!/config/jellyfin/
/config/jellyfin/*
!/config/jellyfin/.gitkeep
!/config/jellyfin/cache/
/config/jellyfin/cache/*
!/config/jellyfin/cache/.gitkeep

!/config/seerr/
/config/seerr/*
!/config/seerr/.gitkeep

!/config/bindery/
/config/bindery/*
!/config/bindery/.gitkeep

!/config/navidrome/
/config/navidrome/*
!/config/navidrome/.gitkeep

.env
.planning/
.DS_Store

# CPython writes bytecode next to the source it imports, so running the
# validators — or the tests that import them — leaves scripts/__pycache__/
# behind in a working tree that should stay clean. Nothing here is ours to
# track: it is regenerated from the .py files on the next import.
__pycache__/
*.py[cod]
.pytest_cache/
