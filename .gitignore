# The library. Never ours to track.
/data/

# Each service's /config is runtime state it writes itself — databases, API
# keys, session tokens.
/config/*/

# Four of those directories also hold templates we ship. Each is re-included,
# then its contents are excluded again, then the template files are named one by
# one. All three steps are needed: git cannot re-include a file whose parent
# directory is excluded, and re-including the directory alone would admit
# everything the service later writes into it.
!/config/recyclarr/
/config/recyclarr/*
!/config/recyclarr/recyclarr.yml

!/config/homepage/
/config/homepage/*
!/config/homepage/settings.yaml
!/config/homepage/services.yaml
!/config/homepage/widgets.yaml

!/config/caddy/
/config/caddy/*
!/config/caddy/Caddyfile

!/config/sabnzbd/
/config/sabnzbd/*
!/config/sabnzbd/sabnzbd.ini

.env
.planning/
.DS_Store

# CPython writes bytecode next to the source it imports, so running the
# validators — or the tests that import them — leaves scripts/__pycache__/
# behind in a working tree that should stay clean. Nothing here is ours to
# track: it is regenerated from the .py files on the next import.
__pycache__/
*.py[cod]
.pytest_cache/
